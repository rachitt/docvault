{
  "name": "@docvault/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DocVault desktop app (Electron + React, Notion-style)",
  "author": "rachit",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icon": "python3 build/gen_icon.py build/icon.png",
    "package:mac": "electron-vite build && electron-builder --mac --dir",
    "package:dmg": "electron-vite build && electron-builder --mac dmg",
    "reinstall": "bash scripts/reinstall.sh",
    "release": "electron-vite build && electron-builder --mac dmg --publish always"
  },
  "dependencies": {
    "@docvault/core": "workspace:*",
    "@docvault/mcp-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "chokidar": "^4.0.3",
    "docx-preview": "^0.3.7",
    "electron-updater": "^6.8.9",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "5.4.296",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@blocknote/core": "^0.25.1",
    "@blocknote/mantine": "^0.25.1",
    "@blocknote/react": "^0.25.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "zustand": "^5.0.3"
  }
}
