{
  "name": "docvault",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first documentation platform with native Claude Code / Codex (MCP) integration",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "core:test": "pnpm --filter @docvault/core test",
    "mcp:build": "pnpm --filter @docvault/mcp-server build",
    "desktop:dev": "pnpm --filter @docvault/desktop dev",
    "typecheck": "pnpm --filter @docvault/core --filter @docvault/mcp-server exec tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "packageManager": "pnpm@11.0.9"
}
